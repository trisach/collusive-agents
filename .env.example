# Copy to .env (gitignored) and fill in the key(s) you use. Never commit .env.
# Variables already set in the shell take precedence over this file.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Output-token cap per call. Empty or 0 = no cap (provider maximum). A low cap cuts off
# reasoning models before they call the tool. --max-completion-tokens overrides this.
MAX_COMPLETION_TOKENS=
# Modal Dedicated Endpoint: written by `uv run python scripts/modal_endpoint.py configure`.
# MODAL_PROXY_TOKEN is "wk-<id>.ws-<secret>"; MODAL_BASE_URL is "<endpoint-url>/v1".
MODAL_BASE_URL=
MODAL_PROXY_TOKEN=
